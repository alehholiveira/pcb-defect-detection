{
  "name": "pcb-defect-backend",
  "version": "1.0.0",
  "description": "Backend service for PCB Defect Detection System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "pcb",
    "defect-detection",
    "fastify"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-eventbridge": "^3.1079.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/client-ses": "^3.1079.0",
    "@aws-sdk/client-sqs": "^3.1075.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "mysql2": "^3.14.1",
    "sequelize": "^6.37.7",
    "zod": "^3.25.11"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^12.0.4",
    "@types/node": "^24.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.0.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
