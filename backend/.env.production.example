# ==============================================================================
# Database (MySQL) - Production
# ==============================================================================
# In production via Docker Compose, DB_HOST should be the name of the database service
DB_HOST=db
DB_PORT=3306
DB_NAME=pcb_defect_db
DB_USER=pcb_user
DB_PASSWORD=pcb_password

# ==============================================================================
# Backend (Node.js) - Production
# ==============================================================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Update CORS_ORIGIN with your actual production domain or keep *
CORS_ORIGIN=http://localhost/

# AWS (Must be filled in production)
AWS_REGION=us-east-1
S3_BUCKET_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SENDER_EMAIL=no-reply@pcbdefect.com

SQS_QUEUE_URL=
EVENTBRIDGE_DAILY_RULE_NAME=
EVENTBRIDGE_WEEKLY_RULE_NAME=
EVENTBRIDGE_MONTHLY_RULE_NAME=
