# ==============================================================================
# Database (MySQL)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pcb_defect_db
DB_USER=pcb_user
DB_PASSWORD=pcb_password
DB_ROOT_PASSWORD=root_password

# ==============================================================================
# Backend (Node.js)
# ==============================================================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# AWS
AWS_REGION=us-east-1
S3_BUCKET_NAME=
SENDER_EMAIL=no-reply@pcbdefect.com

SQS_QUEUE_URL=
EVENTBRIDGE_DAILY_RULE_NAME=pcb-defect-detection-daily-report-rule
EVENTBRIDGE_WEEKLY_RULE_NAME=pcb-defect-detection-weekly-report-rule
EVENTBRIDGE_MONTHLY_RULE_NAME=pcb-defect-detection-monthly-report-rule

APP_TIMEZONE=America/Sao_Paulo
