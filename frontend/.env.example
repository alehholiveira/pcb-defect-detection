# Vite uses proxy by default for local development.
# If you want to bypass proxy and point directly to the servers, uncomment and set these:
# VITE_API_URL=http://192.168.1.100:3000/api/v1
# VITE_ML_SERVICE_URL=http://192.168.1.101:8000/ml-service

# For Vite dev server proxy configuration (if you want to change targets dynamically):
VITE_PROXY_BACKEND_TARGET=http://localhost:3000
VITE_PROXY_ML_TARGET=http://localhost:8000
