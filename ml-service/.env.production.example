CORS_ORIGIN=*
MODELS_DIR=./app/models
CONFIDENCE_THRESHOLD=0.25
MAX_FILE_SIZE=209715200

# Database (MySQL — Docker Compose service name)
DB_HOST=db
DB_PORT=3306
DB_NAME=pcb_defect_db
DB_USER=pcb_user
DB_PASSWORD=pcb_password

# AWS (Must be filled in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=
APP_TIMEZONE=America/Sao_Paulo
